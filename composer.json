{
    "name": "clemens-helling/smv-asw",
    "description": "SMV Antragssystem (Backend in PHP)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-mongodb": "*",
        "mongodb/mongodb": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Smv\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
